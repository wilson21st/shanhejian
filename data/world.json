 "claims": [
  {
   "id": "k1",
   "src": "jts",
   "lens": "zhengshi",
   "stance": "asserts",
   "text": "高祖李渊有三个嫡子：建成、世民、元吉。",
   "quote": null,
   "loc": "旧唐书 卷64",
   "verify": "common"
  },
  {
   "id": "c_taidi",
   "ev": "d13",
   "src": "zztj",
   "lens": "zhengshi",
   "stance": "asserts",
   "text": "建成答应元吉，登位后立他为太弟，所以元吉为他卖命。",
   "quote": "建成許元吉以正位之後，立為太弟",
   "loc": "资治通鉴 卷191"
  },
  {
   "id": "c_gaoshilian",
   "src": "zztj",
   "lens": "zhengshi",
   "stance": "asserts",
   "text": "高士廉是长孙无忌的舅父。",
   "quote": "與其舅雍州治中高士廉",
   "loc": "资治通鉴 卷191"
  },
  {
   "id": "c_heita",
   "ev": "e622",
   "src": "zztj",
   "lens": "zhengshi",
   "stance": "asserts",
   "text": "建成奉诏领兵讨刘黑闼，河南河北诸州都归他调度。",
   "quote": "詔太子建成將兵討黑闥",
   "loc": "资治通鉴 卷190"
  },
  {
   "id": "c_heita_why",
   "ev": "e622",
   "src": "zztj",
   "lens": "zhengshi",
   "stance": "asserts",
   "text": "魏征劝建成出征的理由：殿下只是凭年长居东宫，没有大功服众。",
   "quote": "殿下但以年長位居東宮，無大功以鎮服海內",
   "loc": "资治通鉴 卷190"
  },
  {
   "id": "c_yongliu",
   "ev": "e622",
   "src": "zztj",
   "lens": "zhengshi",
   "stance": "asserts",
   "text": "司马光评：隐太子「庸劣」，却居于太宗之上。",
   "quote": "隱太子以庸劣居其右",
   "loc": "资治通鉴 卷191 臣光曰",
   "conflicts": [
    "m_jiancheng"
   ]
  },
  {
   "id": "m_jiancheng",
   "ev": "e622",
   "src": "modern",
   "lens": "critical",
   "stance": "doubts",
   "text": "建成并非庸才：他平定刘黑闼，长期留守长安理政。「庸劣」是胜利者的评价，经实录传到司马光手上。",
   "quote": null,
   "loc": "现代通说",
   "conflicts": [
    "c_yongliu"
   ]
  },
  {
   "id": "c_wenggan",
   "ev": "e624",
   "src": "zztj",
   "lens": "zhengshi",
   "stance": "asserts",
   "text": "杨文干事连建成，高祖对世民说：你亲自去平叛，回来立你为太子。之后高祖反悔。",
   "quote": "汝宜自行，還，立汝為太子",
   "loc": "资治通鉴 卷191"
  },
  {
   "id": "c_tongyehu",
   "ev": "e625",
   "src": "zztj",
   "lens": "zhengshi",
   "stance": "asserts",
   "text": "西突厥统叶护可汗遣使请婚；裴矩主张远交近攻，借西突厥牵制颉利。",
   "quote": "西突厥統葉護可汗遣使請婚",
   "loc": "资治通鉴 卷191"
  },
  {
   "id": "c_xiashi",
   "ev": "e626a",
   "src": "zztj",
   "lens": "zhengshi",
   "stance": "asserts",
   "text": "李靖在灵州硖石与颉利从早打到下午，突厥才退。",
   "quote": "安州大都督李靖與突厥頡利可汗戰於靈州之硤石",
   "loc": "资治通鉴 卷191"
  },
  {
   "id": "c_zhangliang",
   "ev": "e626b",
   "src": "zztj",
   "lens": "zhengshi",
   "stance": "asserts",
   "text": "世民怕长安有变，派张亮带千余人去洛阳，暗中结交山东豪杰，准备退路。",
   "quote": "遣秦府車騎將軍滎陽張亮將左右王保等千餘人之洛陽，陰結納山東豪傑以俟變",
   "loc": "资治通鉴 卷191"
  },
  {
   "id": "c_luoyang",
   "ev": "e626b",
   "src": "zztj",
   "lens": "zhengshi",
   "stance": "asserts",
   "text": "建成元吉商量：秦王去了洛阳有地有兵，不可再制；留在长安就是一个匹夫。",
   "quote": "秦王若至洛陽，有土地甲兵，不可復制",
   "loc": "资治通鉴 卷191"
  },
  {
   "id": "c_poison",
   "ev": "e626c",
   "src": "zztj",
   "lens": "zhengshi",
   "stance": "asserts",
   "text": "建成夜召世民饮酒下毒，世民心痛，吐血数升。",
   "quote": "建成夜召世民，飲酒而鴆之，世民暴心痛，吐血數升",
   "loc": "资治通鉴 卷191",
   "conflicts": [
    "m_poison"
   ]
  },
  {
   "id": "j_poison",
   "ev": "e626c",
   "src": "jts",
   "lens": "zhengshi",
   "stance": "asserts",
   "text": "旧唐书：建成与元吉合谋下毒，引太宗入宫夜宴，太宗心中暴痛，吐血数升。",
   "quote": "後又與元吉謀行鴆毒，引太宗入宮夜宴，既而太宗心中暴痛，吐血數升",
   "loc": "旧唐书 卷64",
   "conflicts": [
    "m_poison"
   ]
  },
  {
   "id": "m_poison",
   "ev": "e626c",
   "src": "modern",
