   "ev": "w_persia",
   "src": "paschale",
   "lens": "zhengshi",
   "stance": "asserts",
   "text": "波斯军驻迦克墩，但没有船渡海，与阿瓦尔军无法真正会师。",
   "quote": null,
   "loc": "Chronicon Paschale, 626",
   "conf": "medium"
  },
