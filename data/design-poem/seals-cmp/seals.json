 "poem": {
  "id": "p23",
  "title": "早发白帝城",
  "poet": "李白",
  "text": [
   "朝辞白帝彩云间，",
   "千里江陵一日还。",
   "两岸猿声啼不尽，",
   "轻舟已过万重山。"
  ]
 }
